<model name="test_block">
  <static>true</static>
  <pose>0 0 0.05 0 0 0</pose>

  <link name="link">
    <collision name="collision">
      <geometry>
        <box><size>20 20 0.1</size></box>
      </geometry>
      <surface>
        <contact>
          <collide_bitmask>0xFF</collide_bitmask>
        </contact>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>

    <visual name="visual">
      <geometry>
        <box><size>20 20 0.1</size></box>
      </geometry>
      <material>
        <ambient>1 0 0 1</ambient>
        <diffuse>1 0 0 1</diffuse>
      </material>
    </visual>

    <!-- 🟢 Add the contact sensor here -->
    <sensor name="contact_sensor" type="contact">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <contact>
        <collision>collision</collision>
      </contact>
    </sensor>
  </link>

  <!-- 🟢 Add TouchPlugin at the model level -->
  <!--<plugin filename="gz-sim-touchplugin-system"
          name="gz::sim::systems::TouchPlugin">
    <target>go1</target>       
    <namespace>test_block</namespace>
    <time>0.001</time>
    <enabled>true</enabled>
  </plugin> -->
</model>

  </world>
</sdf>
